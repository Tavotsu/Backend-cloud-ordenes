    {
      "name": "3. Notificaciones (correo desde Postman)",
      "item": [
        {
          "name": "Enviar correo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));"
                ]
