            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}{{prefijo}}/api/v1/notificaciones/enviar",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destinatario\": \"{{correo}}\",\n  \"asunto\": \"Prueba desde Postman\",\n  \"mensaje\": \"Correo de prueba de Pedidos360\"\n}"
            }
          }
        },
        {
          "name": "Correo inválido (rechazado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400', () => pm.response.to.have.status(400));"
