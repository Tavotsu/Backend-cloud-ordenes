    {
      "name": "7. Antifraude (más de 3 intentos en 10 segundos)",
      "item": [
        {
          "name": "Tarjeta: 4 intentos seguidos con la misma tarjeta",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Deja pasar la ventana de 10 s de los pagos de la carpeta 5",
                  "setTimeout(() => {}, 11000);",
                  "pm.collectionVariables.set('ordenFraude', 900000 + Math.floor(Math.random() * 90000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const esperados = [400, 400, 403]; const obtenidos = [];",
                  "const siguiente = () => {",
                  "  if (obtenidos.length === esperados.length) {",
                  "    pm.test('Intentos 2 a 4 → ' + esperados.join(', '), () => pm.expect(obtenidos).to.eql(esperados));",
                  "    return;",
                  "  }",
                  "  pm.sendRequest({ url: pm.variables.get('baseUrl') + pm.variables.get('prefijo') + '/api/v1/pagos', method: 'POST', header: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + pm.variables.get('token') }, body: { mode: 'raw', raw: JSON.stringify({ ordenId: Number(pm.variables.get('ordenFraude')), monto: 1000, numeroTarjeta: '5555 5555 5555 4444', titular: 'Prueba', vencimiento: '12/30', cvv: '123' }) } }, (err, res) => { obtenidos.push(res.code); siguiente(); });",
                  "};",
                  "siguiente();",
                  "pm.test('El primero queda APROBADO', () => pm.expect(pm.response.json().estado).to.eql('APROBADO'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}{{prefijo}}/api/v1/pagos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ordenId\": {{ordenFraude}},\n  \"monto\": 1000,\n  \"numeroTarjeta\": \"5555 5555 5555 4444\",\n  \"titular\": \"Prueba\",\n  \"vencimiento\": \"12/30\",\n  \"cvv\": \"123\"\n}"
            },
            "description": "Orden de prueba que no existe en ordenes. 1.º aprobado (201); 2.º y 3.º: 400 'ya está pagada', pero cuentan como intentos; 4.º: 403 BLOQUEADO_FRAUDE y alerta en el dashboard."
          }
        },
        {
          "name": "Webpay: el mismo usuario inicia 4 pagos seguidos",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('ordenFraudeWebpay', Number(pm.collectionVariables.get('ordenFraude')) + 1);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const esperados = [201, 201, 403]; const obtenidos = [];",
                  "const siguiente = () => {",
                  "  if (obtenidos.length === esperados.length) {",
                  "    pm.test('Intentos 2 a 4 → ' + esperados.join(', '), () => pm.expect(obtenidos).to.eql(esperados));",
                  "    return;",
                  "  }",
                  "  pm.sendRequest({ url: pm.variables.get('baseUrl') + pm.variables.get('prefijo') + '/api/v1/pagos/webpay', method: 'POST', header: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + pm.variables.get('token') }, body: { mode: 'raw', raw: JSON.stringify({ ordenId: Number(pm.variables.get('ordenFraude')) + 1, monto: 1000 }) } }, (err, res) => { obtenidos.push(res.code); siguiente(); });",
                  "};",
                  "siguiente();"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}{{prefijo}}/api/v1/pagos/webpay",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ordenId\": {{ordenFraudeWebpay}},\n  \"monto\": 1000\n}"
            },
