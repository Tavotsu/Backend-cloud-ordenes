            "url": "{{baseUrl}}{{prefijo}}/api/v1/notificaciones/enviar",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destinatario\": \"no-es-correo\",\n  \"asunto\": \"x\",\n  \"mensaje\": \"y\"\n}"
            }
          }
        },
        {
          "name": "Historial de notificaciones",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{prefijo}}/api/v1/notificaciones?destinatario={{correo}}"
          }
        }
      ]
