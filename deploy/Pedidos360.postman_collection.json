{
  "info": {
    "name": "Pedidos360",
    "description": "Pruebas de Pedidos360 a través del AWS API Gateway.\n\n1. Inicia sesión en https://44.207.141.228 y copia el token (F12 → Network → header Authorization, sin 'Bearer').\n2. Pégalo en la variable `token` de la colección.\n3. Si el token es de AWS Cognito, cambia la variable `prefijo` a `/cognito`.\n4. Run collection: cada petición verifica el código HTTP esperado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://lxee04oi4d.execute-api.us-east-1.amazonaws.com"
    },
    {
      "key": "prefijo",
      "value": "",
      "description": "Vacío para Microsoft (Entra ID), /cognito para AWS Cognito"
    },
    {
      "key": "token",
      "value": "",
      "description": "JWT del usuario (sin la palabra Bearer)"
    },
    {
      "key": "correo",
      "value": "cr.valdebenitop@duocuc.cl"
    }
  ],
