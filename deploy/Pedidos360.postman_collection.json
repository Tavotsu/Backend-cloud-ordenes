{
  "info": {
    "name": "Pedidos360",
    "description": "Pruebas de Pedidos360 a través del AWS API Gateway.\n\n1. Inicia sesión en https://3.213.91.126 y copia el token (F12 → Network → header Authorization, sin 'Bearer').\n2. Pégalo en la variable `token` de la colección.\n3. Si el token es de AWS Cognito, cambia la variable `prefijo` a `/cognito`.\n4. Run collection: cada petición verifica el código HTTP esperado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://nub4p4p3ga.execute-api.us-east-1.amazonaws.com"
    },
    {
      "key": "prefijo",
      "value": "",
      "description": "Vacío para Microsoft (Entra ID), /cognito para AWS Cognito"
    },
    {
      "key": "token",
      "value": "",
      "description": "JWT del usuario (sin la palabra Bearer)"
    },
    {
      "key": "correo",
      "value": "cr.valdebenitop@duocuc.cl"
    }
  ],
  "item": [
    {
      "name": "1. API Gateway: validación del JWT",
      "item": [
        {
          "name": "Endpoint público sin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{prefijo}}/api/v1/catalogo/public",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Endpoint protegido SIN token (rechazado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{prefijo}}/api/v1/ordenes",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Endpoint protegido con token válido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{prefijo}}/api/v1/ordenes"
          }
        },
        {
          "name": "Claims del token (auth/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{prefijo}}/api/v1/auth/me"
          }
        }
      ]
    },
