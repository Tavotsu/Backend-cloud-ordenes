# Copiar a .env y completar. El .env NO se sube a ningún repositorio.

# IP pública (Elastic IP) o dominio de la EC2. En local: localhost
# Se usa para el CORS de los backends y el certificado HTTPS del frontend.
# La Redirect URI SPA en Entra ID debe ser https://<PUBLIC_HOST>/
PUBLIC_HOST=localhost

# Base de datos: endpoint de Amazon RDS (o "postgres" para la base local con --profile db-local)
DB_HOST=pedidos360-db.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=pedidos360
DB_PASS=cambiar-esta-clave

RABBITMQ_USER=pedidos360
RABBITMQ_PASS=cambiar-esta-clave
# Cadena larga cualquiera; ambos nodos del clúster la comparten
RABBITMQ_ERLANG_COOKIE=cambiar-esta-cookie-larga-y-secreta

# AWS Cognito (segundo proveedor de login)
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Clave para el hash de las tarjetas en ms-pago (cadena larga cualquiera)
PAGO_HASH_SECRET=cambiar-este-secreto

# Webpay Plus: ruta pública del API Gateway a la que Transbank devuelve al cliente
WEBPAY_URL_RETORNO=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/api/v1/pagos/webpay/retorno

# Analítica: true para guardar perfiles en Amazon DynamoDB (en la EC2 usa el rol LabInstanceProfile)
DYNAMODB_ENABLED=false

# Memoria máxima por microservicio (la JVM usa el 70%)
BACKEND_MEM_LIMIT=512m

# --- Correo (microservicio notificaciones) ---
# Poner MAIL_ENABLED=true para enviar de verdad. Con Gmail:
#  1) Cuenta Google con verificación en 2 pasos activada.
#  2) Crear una "Contraseña de aplicación" en https://myaccount.google.com/apppasswords
#  3) MAIL_USERNAME = tu correo Gmail, MAIL_PASSWORD = los 16 caracteres de la app password.
MAIL_ENABLED=false
MAIL_USERNAME=tucorreo@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM=tucorreo@gmail.com

# --- Kafka (docker-compose.kafka.yml) ---
# Host que los brokers anuncian a clientes FUERA de Docker (IP pública de la EC2 de Kafka).
# Los microservicios dentro de la red Docker no lo usan (se conectan por kafka1:29092, etc.)
KAFKA_EXTERNAL_HOST=localhost
# Memoria máxima por broker
KAFKA_MEM_LIMIT=640m
# Acceso al panel Kafka-UI (http://<host>:8090)
KAFKA_UI_USER=admin
KAFKA_UI_PASS=cambiar-esta-clave
