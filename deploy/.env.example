# Copiar a .env y completar. El .env NO se sube a ningún repositorio.

# IP pública (Elastic IP) o dominio de la EC2. En local: localhost
# Se usa para el CORS de los backends y el certificado HTTPS del frontend.
# La Redirect URI SPA en Entra ID debe ser https://<PUBLIC_HOST>/
PUBLIC_HOST=localhost

# Base de datos: endpoint de Amazon RDS (o "postgres" para la base local con --profile db-local)
DB_HOST=pedidos360-db.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=pedidos360
DB_PASS=cambiar-esta-clave

RABBITMQ_USER=pedidos360
RABBITMQ_PASS=cambiar-esta-clave
# Cadena larga cualquiera; ambos nodos del clúster la comparten
RABBITMQ_ERLANG_COOKIE=cambiar-esta-cookie-larga-y-secreta

# Memoria máxima por microservicio (la JVM usa el 70%)
BACKEND_MEM_LIMIT=512m
